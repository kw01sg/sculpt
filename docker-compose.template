# Copy this file to docker-compose.<env>.env and fill in real values.
# cp docker-compose.prod.template docker-compose.<env>.env
# docker-compose.<env>.env is gitignored — never commit it.

# PostgreSQL Settings
POSTGRES_DB=sculpt
POSTGRES_USER=<your_db_user>
POSTGRES_PASSWORD=<your_strong_password>
POSTGRES_HOST=db
POSTGRES_PORT=5432
TZ=Asia/Singapore

# Backend Settings
DATABASE_URL=postgresql+asyncpg://<your_db_user>:<your_strong_password>@db/sculpt
SECRET_KEY=<generate_with: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — add your domain when you have one, comma-separated
# Example: CORS_ORIGINS=https://myapp.onrender.com,https://myapp.com
CORS_ORIGINS=https://yourdomain.com
