# Gitignore for Sculpt project

# Python
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/

# Node.js / React
# ========================
node_modules/
build/
.env.local
.env.development.local
.env.test.local
.env.production.local
.next/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.DS_Store
*.log
.eslintcache

# Docker
# ========================
*.env
*.env.*
!.env.example # if you have an example env file
!docker-compose.env # specifically keep this for docker-compose
!docker-compose.prod.template # keep the template, but not the real prod env

# IDEs
# ========================
.idea/
.vscode/
*.swp
*.swo

# OS specific
# ========================
.DS_Store
Thumbs.db
